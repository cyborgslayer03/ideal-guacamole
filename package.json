{
  "name": "omniverse-forge",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "hub": "tsx server/main.ts",
    "hub:dev": "tsx watch server/main.ts",
    "start": "npm run build && STATIC_DIR=dist tsx server/main.ts"
  },
  "dependencies": {
    "three": "0.186.1"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "@types/three": "0.186.0",
    "tsx": "^4.23.15",
    "typescript": "5.9.3",
    "vite": "7.3.7",
    "vitest": "3.2.7"
  }
}
